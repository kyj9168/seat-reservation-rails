<% content_for :title, "새 비밀번호 설정" %>
<section class="auth-card">
  <p class="eyebrow">NEW PASSWORD</p>
  <h1>새 비밀번호 설정</h1>
  <% if @user.errors.any? %><div class="error-box"><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with url: update_password_path(params[:token]), method: :patch, class: "stack-form" do |form| %>
    <div class="field"><%= form.label :password, "새 비밀번호 (8자 이상)" %><%= form.password_field :password, required: true, autocomplete: "new-password" %></div>
    <div class="field"><%= form.label :password_confirmation, "새 비밀번호 확인" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
    <%= form.submit "비밀번호 변경", class: "button button-primary" %>
  <% end %>
</section>
